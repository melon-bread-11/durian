generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Availability {
  AVAILABLE
  SEASONAL
  SOLD_OUT
}

enum EnquiryStatus {
  NEW
  CONTACTED
  CLOSED
}

model Product {
  id           String       @id @default(cuid())
  slug         String       @unique
  name         String
  description  String
  tastingNotes String
  imageUrl     String?
  pricePerKg   Decimal?     @db.Decimal(10, 2)
  availability Availability @default(SEASONAL)
  archived     Boolean      @default(false)
  isSample     Boolean      @default(false)
  enquiries    Enquiry[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Enquiry {
  id           String        @id @default(cuid())
  productId    String
  product      Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  customerName String
  phone        String
  quantityKg   Decimal?      @db.Decimal(6, 2)
  message      String
  status       EnquiryStatus @default(NEW)
  createdAt    DateTime      @default(now())

  @@index([productId])
  @@index([status, createdAt])
}
